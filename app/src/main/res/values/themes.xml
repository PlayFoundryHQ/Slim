<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Slim" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Opaque black starting window. The default background mode is
             BG_SOLID_BLACK, and applyBackgroundMode() opts back into the
             wallpaper at runtime for the transparent/dimmed modes. Starting
             transparent+showWallpaper here meant every cold start briefly
             painted the system wallpaper before onResume flipped the window
             to black — a wallpaper flash on the default configuration. A black
             first frame is invisible against the (black) content that follows;
             for the wallpaper modes it is a far less jarring transition than
             wallpaper -> black -> content. -->
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:windowShowWallpaper">false</item>
        <!-- Deliberately NOT windowIsTranslucent: a translucent activity gets no
             starting window at all (so the previous app / wallpaper shows until
             the first frame), which is exactly the flash we are removing. The
             wallpaper-backed modes (transparent / dimmed) work through
             FLAG_SHOW_WALLPAPER, added at runtime by setShowWallpaper() — that
             flag composites the wallpaper behind any non-opaque region of the
             window background without needing a translucent window. -->
        <!-- Translucent status and navigation bars -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="colorPrimary">@color/accent_indigo</item>
    </style>

    <!-- Dialog chrome matching Slim's own dark surface palette instead of the
         stock Material dialog (white/light background), used for the app
         long-press menu, rename prompt, and similar in-app dialogs. -->
    <style name="Theme.Slim.Dialog" parent="ThemeOverlay.Material3.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_background</item>
        <item name="colorPrimary">@color/accent_indigo</item>
        <item name="colorAccent">@color/accent_indigo</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorAlertDialogListItem">@color/text_primary</item>
    </style>

    <!-- Opaque variant for the Settings screen -->
    <style name="Theme.Slim.Settings">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowIsTranslucent">false</item>
    </style>

    <!-- ======== Settings screen widget styles ======== -->
    <style name="SettingsSectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">32dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/accent_indigo</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.1</item>
    </style>

    <style name="SettingsSwitch">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="SettingsRadio">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingVertical">8dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="SettingsActionRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingVertical">14dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
    </style>
</resources>
